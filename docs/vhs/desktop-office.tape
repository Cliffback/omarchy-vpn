# Still: cursor on office, details updated. Always --demo. No stoplights.

Output docs/screenshots/desktop-office.gif

Require ./omarchy-vpn

Set Shell bash
Set FontFamily "CaskaydiaMono Nerd Font"
Set FontSize 14
Set Width 1200
Set Height 720
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0ms
Set Framerate 24

Hide
Type "./omarchy-vpn --demo"
Enter
Sleep 800ms
Show
Down
Sleep 2s
Type "q"
Sleep 300ms
