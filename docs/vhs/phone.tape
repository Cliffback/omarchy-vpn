# Phone stack. Browse then toggle. Always --demo. No stoplights.

Output docs/screenshots/phone.gif

Require ./omarchy-vpn

Set Shell bash
Set FontFamily "CaskaydiaMono Nerd Font"
Set FontSize 13
Set Width 520
Set Height 980
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0ms
Set Framerate 24

Hide
Type "./omarchy-vpn --demo"
Enter
Sleep 800ms
Show
Sleep 1s
Down
Sleep 1.2s
Enter
Sleep 1.6s
Type "q"
Sleep 300ms
